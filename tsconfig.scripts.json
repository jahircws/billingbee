{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": ".scripts-out",
    "noEmit": false
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true
  },
  "include": ["scripts/**/*.ts", "lib/generated/prisma/**/*.ts"]
}
