# ============================================================
# BillingBee v2.0 — Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to version control.
# ============================================================

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://billingbee.co
NEXT_PUBLIC_APP_NAME=BillingBee
NODE_ENV=production

# ------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/billingbee?schema=public"
# For connection pooling (PgBouncer / Supabase pooler)
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/billingbee?schema=public"

# ------------------------------------------------------------
# Auth (NextAuth v5 / Auth.js)
# ------------------------------------------------------------
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL=https://billingbee.co

# OAuth providers (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ------------------------------------------------------------
# Anthropic AI
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ------------------------------------------------------------
# Payments — Razorpay (India)
# ------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Payments — Stripe (International)
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------
# Payments — PayPal
# ------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# sandbox | live
PAYPAL_MODE=live
# From PayPal Developer Dashboard → Webhooks → Webhook ID
PAYPAL_WEBHOOK_ID=

# ------------------------------------------------------------
# Email (Resend)
# ------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=invoices@billingbee.co
EMAIL_FROM_NAME=BillingBee

# ------------------------------------------------------------
# Rate Limiting (Upstash Redis)
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# Storage (Supabase or S3-compatible)
# ------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# S3-compatible (for PDF/logo storage)
S3_BUCKET_NAME=billingbee-files
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=                    # Leave blank for AWS; set for Supabase Storage / R2

# ------------------------------------------------------------
# GST / Indian Tax
# ------------------------------------------------------------
GST_PORTAL_API_KEY=             # Optional: GSTIN validation API

# ------------------------------------------------------------
# Analytics & Monitoring
# ------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
CRON_SECRET="generate-with: openssl rand -hex 32"   # Secures /api/cron/* routes
INVOICE_ENCRYPTION_KEY="generate-with: openssl rand -hex 32"
