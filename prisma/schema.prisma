// BillingBee v2.0 — Prisma Schema
// Every tenant model carries orgId for strict row-level isolation.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrgRole {
  OWNER
  MEMBER
  VIEWER
}

enum CollectionTone {
  FRIENDLY
  REMINDER
  FIRM
  ESCALATE
}

enum CollectionStatus {
  PENDING
  SENT
  SKIPPED
  CANCELLED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  OVERDUE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  PAYPAL
  BANK_TRANSFER
  CASH
  CHEQUE
  OTHER
}

enum Currency {
  // South Asia
  INR
  PKR
  BDT
  LKR
  NPR
  MVR
  // North America
  USD
  CAD
  MXN
  // Europe
  EUR
  GBP
  CHF
  SEK
  NOK
  DKK
  PLN
  CZK
  HUF
  RON
  BGN
  ISK
  UAH
  RSD
  BAM
  MKD
  MDL
  // East Asia
  JPY
  CNY
  KRW
  TWD
  HKD
  MNT
  // Southeast Asia
  SGD
  MYR
  THB
  PHP
  IDR
  VND
  KHR
  BND
  MOP
  LAK
  // Central Asia
  KZT
  UZS
  AZN
  GEL
  AMD
  KGS
  TJS
  TMT
  // Middle East & North Africa
  AED
  SAR
  QAR
  KWD
  BHD
  OMR
  JOD
  ILS
  IQD
  EGP
  MAD
  TND
  DZD
  // Sub-Saharan Africa
  ZAR
  NGN
  KES
  GHS
  ETB
  TZS
  UGX
  RWF
  MUR
  XAF
  XOF
  ZMW
  BWP
  SCR
  MZN
  AOA
  MGA
  CDF
  MWK
  CVE
  // Latin America
  BRL
  ARS
  CLP
  COP
  PEN
  UYU
  BOB
  GTQ
  HNL
  DOP
  TTD
  JMD
  CRC
  PYG
  NIO
  GYD
  SRD
  // Pacific
  AUD
  NZD
  FJD
  PGK
  XPF
  // Caribbean
  XCD
}

enum AdminRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum ContractStatus {
  DRAFT
  SENT
  ACCEPTED
  SIGNED
}

// ---------------------------------------------------------------------------
// Organization (tenant root)
// ---------------------------------------------------------------------------

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String   @default("IN")
  pincode     String?
  gstin       String?
  pan         String?
  logo        String?
  upiQrUrl    String?
  upiId       String?
  currency    Currency @default(INR)
  timezone    String   @default("Asia/Kolkata")
  plan             String    @default("free")
  planExpiry       DateTime?
  stripeCustomerId String?   @unique
  isActive         Boolean   @default(true)
  acquisitionSource String?
  onboardingGoal  String?
  onboardingDone  Boolean   @default(false)
  lastForecastAt        DateTime?
  day5ProNudgeSentAt    DateTime?
  day14UpgradePushSentAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orgUsers             OrgUser[]
  clients              Client[]
  invoices             Invoice[]
  quotes               Quote[]
  taxes                Tax[]
  categories           Category[]
  items                Item[]
  expenses             Expense[]
  payments             Payment[]
  paymentGatewayConfig PaymentGatewayConfig[]
  collectionEvents     CollectionEvent[]
  proposals            Proposal[]
  contracts            Contract[]
  aiUsageLogs          AIUsageLog[]
  issueReports         IssueReport[]

  @@index([plan])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// User (auth identity — org-agnostic)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  phone         String?   @unique
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orgUsers     OrgUser[]
  issueReports IssueReport[]

  // NextAuth v5 relations
  accounts Account[]
  sessions Session[]
}

// ---------------------------------------------------------------------------
// OrgUser — membership pivot (tenant-scoped user)
// ---------------------------------------------------------------------------

model OrgUser {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)
  isActive  Boolean  @default(true)
  invitedAt DateTime @default(now())
  joinedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// NextAuth v5 support models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Client
// ---------------------------------------------------------------------------

model Client {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  slug        String?
  email       String?
  phone       String?
  company     String?
  gstin       String?
  pan         String?
  address     String?
  city        String?
  state       String?
  country     String   @default("IN")
  pincode     String?
  currency    Currency @default(INR)
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org          Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  quotes       Quote[]
  payments     Payment[]
  portalUsers  ClientPortalUser[]
  proposals    Proposal[]
  contracts    Contract[]

  @@index([orgId])
  @@index([orgId, email])
  @@index([orgId, slug])
}

// ---------------------------------------------------------------------------
// Invoice
// ---------------------------------------------------------------------------

model Invoice {
  id              String        @id @default(cuid())
  orgId           String
  clientId        String
  invoiceNumber   String
  status          InvoiceStatus @default(DRAFT)
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  currency        Currency      @default(INR)
  // Rate from this invoice's currency → the org's base currency, frozen at
  // issue time. 1 for invoices already in the org currency. Used by health
  // metrics so cross-currency totals are comparable (see lib/fx.ts).
  fxRate          Decimal       @db.Decimal(18, 8) @default(1)
  subtotal        Decimal       @db.Decimal(12, 2) @default(0)
  taxAmount       Decimal       @db.Decimal(12, 2) @default(0)
  discountAmount  Decimal       @db.Decimal(12, 2) @default(0)
  total           Decimal       @db.Decimal(12, 2) @default(0)
  amountPaid      Decimal       @db.Decimal(12, 2) @default(0)
  amountDue       Decimal       @db.Decimal(12, 2) @default(0)
  notes           String?       @db.Text
  terms           String?       @db.Text
  pdfUrl          String?
  sentAt          DateTime?
  paidAt          DateTime?
  viewedAt        DateTime?
  reminderSentAt  DateTime?
  isRecurring     Boolean       @default(false)
  recurringCron   String?
  autoFollowUp    Boolean       @default(false)
  aiPrompt        String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client           Client            @relation(fields: [clientId], references: [id])
  items            InvoiceItem[]
  payments         Payment[]
  collectionEvents CollectionEvent[]

  @@unique([orgId, invoiceNumber])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, clientId])
  @@index([orgId, createdAt])
  @@index([orgId, issueDate])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// InvoiceItem
// ---------------------------------------------------------------------------

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  hsn         String?
  quantity    Decimal  @db.Decimal(10, 3) @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @db.Decimal(5, 2)  @default(0)
  taxName     String?  @default("GST")
  taxType     String?  @default("PERCENTAGE")
  taxAmount   Decimal  @db.Decimal(12, 2) @default(0)
  discount    Decimal  @db.Decimal(5, 2)  @default(0)
  total       Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Quote
// ---------------------------------------------------------------------------

model Quote {
  id            String      @id @default(cuid())
  orgId         String
  clientId      String
  quoteNumber   String
  status        QuoteStatus @default(DRAFT)
  issueDate     DateTime    @default(now())
  expiryDate    DateTime?
  currency      Currency    @default(INR)
  subtotal      Decimal     @db.Decimal(12, 2) @default(0)
  taxAmount     Decimal     @db.Decimal(12, 2) @default(0)
  discountAmount Decimal    @db.Decimal(12, 2) @default(0)
  total         Decimal     @db.Decimal(12, 2) @default(0)
  notes         String?     @db.Text
  terms         String?     @db.Text
  pdfUrl        String?
  sentAt        DateTime?
  acceptedAt    DateTime?
  rejectedAt    DateTime?
  aiPrompt      String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client Client       @relation(fields: [clientId], references: [id])
  items  QuoteItem[]

  @@unique([orgId, quoteNumber])
  @@index([orgId])
  @@index([orgId, clientId])
}

// ---------------------------------------------------------------------------
// QuoteItem
// ---------------------------------------------------------------------------

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  description String
  quantity    Decimal  @db.Decimal(10, 3) @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
  taxRate     Decimal  @db.Decimal(5, 2)  @default(0)
  taxAmount   Decimal  @db.Decimal(12, 2) @default(0)
  discount    Decimal  @db.Decimal(5, 2)  @default(0)
  total       Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

// ---------------------------------------------------------------------------
// Tax
// ---------------------------------------------------------------------------

model Tax {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  rate        Decimal  @db.Decimal(5, 2)
  description String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Category (for expenses and items)
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  color     String?
  icon      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  expenses Expense[]
  items    Item[]

  @@unique([orgId, name])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Item (product/service catalog)
// ---------------------------------------------------------------------------

model Item {
  id          String   @id @default(cuid())
  orgId       String
  categoryId  String?
  name        String
  description String?  @db.Text
  unitPrice   Decimal  @db.Decimal(12, 2) @default(0)
  unit        String?
  taxRate     Decimal  @db.Decimal(5, 2)  @default(0)
  hsn         String?
  sku         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category Category?    @relation(fields: [categoryId], references: [id])

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Expense
// ---------------------------------------------------------------------------

model Expense {
  id          String   @id @default(cuid())
  orgId       String
  categoryId  String?
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  currency    Currency @default(INR)
  date        DateTime
  vendor      String?
  receiptUrl  String?
  notes       String?  @db.Text
  isBillable  Boolean  @default(false)
  isReimbursed Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category Category?    @relation(fields: [categoryId], references: [id])

  @@index([orgId])
  @@index([orgId, date])
}

// ---------------------------------------------------------------------------
// Payment
// ---------------------------------------------------------------------------

model Payment {
  id              String        @id @default(cuid())
  orgId           String
  invoiceId       String
  clientId        String
  amount          Decimal       @db.Decimal(12, 2)
  currency        Currency      @default(INR)
  method          PaymentMethod
  gatewayPaymentId String?
  gatewayOrderId  String?
  gatewaySignature String?
  status          String        @default("pending")
  paidAt          DateTime?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id])
  client  Client       @relation(fields: [clientId], references: [id])

  @@index([orgId])
  @@index([invoiceId])
  @@index([gatewayPaymentId])
  @@index([invoiceId, createdAt])
}

// ---------------------------------------------------------------------------
// ClientPortalUser — unauthenticated portal access via magic link
// ---------------------------------------------------------------------------

model ClientPortalUser {
  id           String    @id @default(cuid())
  clientId     String
  email        String
  token        String    @unique
  passwordHash String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([token])
  @@index([email])
}

// ---------------------------------------------------------------------------
// PaymentGatewayConfig — encrypted per-org gateway credentials
// ---------------------------------------------------------------------------

model PaymentGatewayConfig {
  id              String        @id @default(cuid())
  orgId           String
  gateway         PaymentMethod
  isActive        Boolean       @default(false)
  // Stored encrypted (AES-256-GCM via lib/crypto.ts)
  encryptedConfig String        @db.Text
  webhookSecret   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, gateway])
  @@index([orgId])
}

// ---------------------------------------------------------------------------
// AdminUser — internal BillingBee staff
// ---------------------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(SUPPORT)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs AdminLog[]
}

// ---------------------------------------------------------------------------
// AdminLog — audit trail for admin actions
// ---------------------------------------------------------------------------

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String?
  targetId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// FxRate — daily foreign-exchange rates (open.er-api.com), cached for
// converting per-invoice currencies into an org's base currency.
// rate = units of `quote` per 1 unit of `base`. Refreshed by the
// app/api/cron/fx-rates daily job.
// ---------------------------------------------------------------------------

model FxRate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  base      Currency
  quote     Currency
  rate      Decimal  @db.Decimal(18, 8)
  createdAt DateTime @default(now())

  @@unique([date, base, quote])
  @@index([base, quote, date])
}

// ---------------------------------------------------------------------------
// CollectionEvent — AI-driven autonomous invoice follow-up
// ---------------------------------------------------------------------------

model CollectionEvent {
  id          String           @id @default(cuid())
  orgId       String
  invoiceId   String
  dayNumber   Int              // days after dueDate (1, 7, 15, 30, 45, 90)
  tone        CollectionTone
  status      CollectionStatus @default(PENDING)
  scheduledAt DateTime
  sentAt      DateTime?
  subject     String?
  htmlBody    String?          @db.Text
  textBody    String?          @db.Text
  errorMsg    String?
  attempts    Int              @default(0) // failed send count; retried up to MAX_ATTEMPTS in the cron
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([orgId])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Proposal
// ---------------------------------------------------------------------------

model Proposal {
  id         String         @id @default(cuid())
  orgId      String
  clientId   String
  title      String
  status     ProposalStatus @default(DRAFT)
  sections   Json           @default("[]")
  pricing    Json?
  timeline   String?
  aiPrompt   String?        @db.Text
  sentAt     DateTime?
  viewedAt   DateTime?
  acceptedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client   Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract Contract?

  @@index([orgId])
  @@index([clientId])
  @@index([orgId, status])
  @@index([orgId, sentAt])
}

// ---------------------------------------------------------------------------
// AIUsageLog — per-org AI call tracking for admin analytics
// ---------------------------------------------------------------------------

model AIUsageLog {
  id         String   @id @default(cuid())
  orgId      String?
  type       String   // "copilot" | "extract" | "generate" | "cashflow" | "collection"
  model      String   @default("claude-haiku-4-5")
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  createdAt  DateTime @default(now())

  org Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([createdAt])
  @@index([type, createdAt])
}

// ---------------------------------------------------------------------------
// Contract
// ---------------------------------------------------------------------------

model Contract {
  id            String         @id @default(cuid())
  orgId         String
  clientId      String
  proposalId    String?        @unique
  invoiceId     String?
  title         String
  status        ContractStatus @default(DRAFT)
  content       String         @db.Text
  // Portal delivery
  token         String?        @unique
  sentAt        DateTime?
  viewedAt      DateTime?
  // Signing proof
  signedAt      DateTime?
  signedBy      String?
  signatureData String?        @db.Text
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client   Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  proposal Proposal?    @relation(fields: [proposalId], references: [id])

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, sentAt])
  @@index([clientId])
  @@index([token])
}

// ---------------------------------------------------------------------------
// IssueReport — manual bug reports + auto-captured 404/500 errors
// ---------------------------------------------------------------------------

model IssueReport {
  id          String   @id @default(cuid())
  type        String   // "MANUAL" | "ERROR_404" | "ERROR_500"
  title       String
  description String?  @db.Text
  url         String
  userId      String?
  userName    String?
  userEmail   String?
  orgId       String?
  orgName     String?
  status      String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED
  metadata    Json?
  createdAt   DateTime @default(now())

  org  Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([orgId])
  @@index([createdAt])
}
model EmailOpen {
  id        String   @id @default(cuid())
  email     String
  segment   String?
  openedAt  DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([email])
  @@index([openedAt])
}

model ToolRateLimit {
  id          String   @id @default(cuid())
  ip          String
  tool        String
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@unique([ip, tool])
  @@index([ip, tool])
}

model EmailUnsubscribe {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
